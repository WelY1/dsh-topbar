{
  "name": "dsh-topbar",
  "version": "0.4.8",
  "description": "Push DSH session status to the GNOME top bar (Ubuntu/GNOME 3.36). Gray=running, green=done (unacknowledged), yellow=waiting (approval/question/plan review). Configurable from this plugin's entry on the sidebar Plugins page; auto-installs its GNOME extension half.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "gnome",
    "gnome-shell",
    "gnome-extension",
    "topbar",
    "panel",
    "session",
    "status-indicator",
    "linux"
  ],
  "homepage": "https://gitee.com/We1YI/dsh-topbar",
  "bugs": {
    "url": "https://gitee.com/We1YI/dsh-topbar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/We1YI/dsh-topbar.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "extension",
    "install.sh",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "sessions",
        "uiSession",
        "timer",
        "slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.1-rc.1": "compatible",
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.2": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    },
    "inventory": {
      "title": {
        "zh": "顶栏会话指示器",
        "en": "Top bar session indicator"
      },
      "description": {
        "zh": "把各会话的运行状态推到 GNOME 顶栏：灰=运行中，绿=已完成未确认，黄=等待回复/审批。可在侧边栏 Plugins 页的本插件条目中配置字号、宽度、上限、显示状态与点击行为。",
        "en": "Push per-session status to the GNOME top bar: gray=running, green=done, yellow=waiting. Configurable from this plugin's entry on the sidebar Plugins page; auto-installs its GNOME extension."
      }
    }
  },
  "license": "MIT",
  "sideEffects": [
    "./lib/client.js"
  ]
}
